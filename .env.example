# ============================================================
# TruthLens — Production & Local Environment Configuration
# ============================================================

# ── Backend Configuration (Render Web Service) ───────────────
# Port to bind (Render automatically sets $PORT in production)
PORT=8000

# Secret key for JWT session signing (Generate a secure random string for production)
SECRET_KEY=change_me_to_a_secure_random_key_in_production

# CORS Configuration: URL of the deployed frontend static site on Render
# Example: https://truthlens-frontend.onrender.com
FRONTEND_URL=https://truthlens-frontend.onrender.com

# Optional additional CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Defaults to local SQLite; supports PostgreSQL on Render)
# DATABASE_URL=sqlite:///./deepsafe_history.db
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Machine Learning Runtime Settings
USE_TF=0
USE_TORCH=1
USE_GPU=false

# Optional HuggingFace cache directory
# HF_HOME=~/.cache/huggingface

# ── Frontend Configuration (Render Static Site) ──────────────
# URL pointing to the deployed backend Web Service on Render
# Example: https://truthlens-api.onrender.com
REACT_APP_API_URL=https://truthlens-api.onrender.com
# REACT_APP_API_BASE_URL=https://truthlens-api.onrender.com

# Firebase Client Configuration (from Firebase Console)
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=truthlens-6aa27.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=truthlens-6aa27
REACT_APP_FIREBASE_STORAGE_BUCKET=truthlens-6aa27.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=221842927887
REACT_APP_FIREBASE_APP_ID=1:221842927887:web:52a363a90729bcfcbe0e7a
