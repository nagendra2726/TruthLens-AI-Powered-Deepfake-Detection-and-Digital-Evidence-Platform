# ============================================================
# TruthLens Backend Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# Backend Server
PORT=8000

# SQLite Database path (relative to project root)
# DEEPSAFE_DB_PATH=deepsafe_history.db

# AI Model Cache Directory (HuggingFace Hub cache)
# HF_HOME=~/.cache/huggingface

# Force PyTorch only (prevents TensorFlow import segfault on macOS Python 3.13+)
USE_TF=0
USE_TORCH=1

# Legacy model service ports (used only with Docker Compose multi-service setup)
NPR_PORT=5001
UNIVERSAL_PORT=5004
CROSS_EFFICIENT_VIT_PORT=7001

# GPU support
USE_GPU=false
MODEL_TIMEOUT=600
