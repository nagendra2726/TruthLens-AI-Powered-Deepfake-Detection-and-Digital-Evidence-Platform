rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User profiles ────────────────────────────────────────────────────
    // Only the authenticated user who owns the document may read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // ─── Analysis history sub-collection ────────────────────────────────
      // Each analysis document is private to its owner.
      match /analyses/{analysisId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Deny everything else by default (belt-and-suspenders).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
